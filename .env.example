# LLM Configuration - Using Ollama for development
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.7
OLLAMA_BASE_URL=http://127.0.0.1:11434

# vLLM Configuration - For production deployment
VLLM_BASE_URL=http://localhost:8000/v1

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/agentic_pipeline
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=agentic_pipeline

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_org/your_repo

# Hugging Face Configuration
HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL_ID=Qwen/Qwen2.5-7B

# Podman Configuration
PODMAN_SOCKET=unix:///run/podman/podman.sock

# Argo CD Configuration (required for GitOps deployment)
ARGOCD_URL=https://argocd.example.com
ARGOCD_USERNAME=admin
ARGOCD_PASSWORD=password

# Kubernetes Configuration
DEFAULT_NAMESPACE=model-serving
DEFAULT_REPLICAS=1
DEFAULT_SERVICE_TYPE=LoadBalancer
DEFAULT_SERVICE_PORT=8000

# vLLM Configuration
DEFAULT_VLLM_IMAGE=vllm/vllm-openai
VLLM_IMAGE_TAG=latest
DEFAULT_GPU_MEMORY_UTILIZATION=0.9
DEFAULT_MAX_MODEL_LEN=4096
DEFAULT_TENSOR_PARALLEL_SIZE=1
DEFAULT_MODEL_PATH_PREFIX=/models

# Health Check Configuration
HEALTH_CHECK_INITIAL_DELAY=30
HEALTH_CHECK_PERIOD=10
LIVENESS_INITIAL_DELAY=60
LIVENESS_PERIOD=30

# Resource Defaults
DEFAULT_CPU_REQUEST=2
DEFAULT_MEMORY_REQUEST=8Gi
DEFAULT_CPU_LIMIT_MULTIPLIER=2
DEFAULT_MEMORY_LIMIT_MULTIPLIER=2

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development

# Primary Agent Configuration
DEFAULT_CONTAINER_REGISTRY=docker.io
DEFAULT_ORGANIZATION=your-org
DEFAULT_BASE_IMAGE=nvidia/cuda:12.1.0-runtime-ubuntu22.04
SERVICE_ENDPOINT_BASE_URL=https://api.example.com/inference

# Serving Framework Configuration
SERVING_FRAMEWORK_PRIORITY=tensorrt-llm,vllm,triton,bentoml,sglang,llama.cpp

# Autoscaling Configuration
DEFAULT_MIN_REPLICAS=2
DEFAULT_MAX_REPLICAS=10
DEFAULT_TARGET_CPU_UTILIZATION=70
DEFAULT_TARGET_MEMORY_UTILIZATION=80
DEFAULT_SCALE_UP_THRESHOLD=80
DEFAULT_SCALE_DOWN_THRESHOLD=30

# Rollout Configuration
DEFAULT_CANARY_INITIAL_TRAFFIC=5
DEFAULT_CANARY_RAMP_UP_HOURS=24
DEFAULT_CANARY_MONITORING_HOURS=48